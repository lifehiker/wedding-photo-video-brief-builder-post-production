generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      WeddingProject[]
  vendors       Vendor[]
  styleGuides   StyleGuide[]
  briefs        Brief[]
  subscription  Subscription?
  onboarding    UserOnboarding?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserOnboarding {
  id           String   @id @default(cuid())
  userId       String   @unique
  role         String?
  outsource    Boolean  @default(false)
  deliverables String?
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeddingProject {
  id            String   @id @default(cuid())
  userId        String
  coupleNames   String
  weddingDate   DateTime?
  venueName     String?
  venueLocation String?
  brandName     String?
  editorName    String?
  editorEmail   String?
  notes         String?
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefs        Brief[]
  projectVendors ProjectVendor[]
}

model Vendor {
  id              String   @id @default(cuid())
  userId          String
  name            String
  category        String
  instagramHandle String?
  website         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectVendors ProjectVendor[]
}

model ProjectVendor {
  id        String @id @default(cuid())
  projectId String
  vendorId  String

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([projectId, vendorId])
}

model StyleGuide {
  id                String   @id @default(cuid())
  userId            String
  name              String
  editingStyle      String?
  colorPreferences  String?
  musicPreferences  String?
  pacingNotes       String?
  socialCaptionStyle String?
  deliveryDefaults  String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brief {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  type          String
  title         String
  formData      String   @default("{}")
  generatedText String?
  status        String   @default("draft")
  shareToken    String?  @unique
  exportCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("free")
  priceId              String?
  plan                 String    @default("free")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
